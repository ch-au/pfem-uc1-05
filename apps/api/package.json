{
  "name": "@fsv/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run postbuild",
    "postbuild": "npm run copy:config && npm run copy:prompts && npm run copy:frontend",
    "copy:config": "mkdir -p dist/apps/api/config && cp -r ../api/config/prompts.yaml dist/apps/api/config/",
    "copy:prompts": "mkdir -p dist/prompts/fallback && cp -r ../../prompts/fallback/* dist/prompts/fallback/",
    "copy:frontend": "mkdir -p dist/frontend && cp -r ../../frontend/dist dist/frontend/",
    "start": "node dist/apps/api/src/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:e2e": "vitest run src/__tests__/e2e",
    "worker:quiz": "tsx src/worker/quiz.worker.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/env": "^5.0.1",
    "@fastify/static": "^8.0.2",
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.3.1",
    "fastify": "^5.2.0",
    "js-yaml": "^4.1.1",
    "langfuse": "^3.0.0",
    "pg": "^8.11.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@vitest/coverage-v8": "^1.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
