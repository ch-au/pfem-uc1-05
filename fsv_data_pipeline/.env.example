# FSV Data Pipeline - copy to .env and fill in

# HTML archive path (relative to this folder or absolute)
# FSVARCHIV_PATH=fsvarchiv

# SQLite DB produced by the parser (relative to this folder)
# SQLITE_DB=fsv_archive_complete.db

# PostgreSQL (Neon or other) - required for sync
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
# or
# DB_URL=postgresql://...

# Legacy compatibility variables kept for archived scripts
# COHERE_API_KEY=
# COHERE_EMBED_MODEL=embed-v4.0
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIM=1024
