{
  "$schema": "./ai-models.schema.json",
  "_comment": "Zentrale Konfiguration für AI-Modelle pro Prompt-Schritt. Provider: openrouter (Node.js) oder litellm (Python)",
  
  "models": {
    "sql_generation": {
      "description": "SQL-Abfragen aus natürlicher Sprache generieren",
      "model": "google/gemini-2.5-flash-preview-09-2025",
      "provider": "openrouter",
      "temperature": 0.3,
      "max_tokens": 2000
    },
    
    "quiz_generation": {
      "description": "Quiz-Fragen basierend auf Daten erstellen",
      "model": "google/gemini-2.5-flash-preview-09-2025",
      "provider": "openrouter",
      "temperature": 0.8,
      "max_tokens": 2000
    },
    
    "chat": {
      "description": "Chat-Antworten für Benutzer-Interaktionen",
      "model": "google/gemini-2.5-flash-preview-09-2025",
      "provider": "openrouter",
      "temperature": 0.7,
      "max_tokens": 1500
    },
    
    "explanation": {
      "description": "Erklärungen für SQL-Ergebnisse oder Daten",
      "model": "google/gemini-2.5-flash-preview-09-2025",
      "provider": "openrouter",
      "temperature": 0.5,
      "max_tokens": 1000
    },
    
    "embeddings": {
      "description": "Text-Embeddings für semantische Suche",
      "model": "text-embedding-3-large",
      "provider": "openai",
      "dimensions": 3072
    }
  },
  
  "defaults": {
    "openrouter": {
      "fallback_model": "google/gemini-2.5-flash-preview-09-2025",
      "timeout_ms": 60000
    },
    "litellm": {
      "fallback_model": "gemini/gemini-flash-latest",
      "timeout_ms": 60000
    }
  },
  
  "available_models": {
    "_comment": "Referenz für verfügbare Modelle",
    "openrouter": [
      "google/gemini-2.5-flash-preview-09-2025",
      "google/gemini-2.0-flash-001",
      "anthropic/claude-3.5-sonnet",
      "anthropic/claude-3-opus",
      "openai/gpt-4o",
      "openai/gpt-4o-mini",
      "meta-llama/llama-3.1-70b-instruct"
    ],
    "litellm": [
      "gemini/gemini-flash-latest",
      "gemini/gemini-pro",
      "gpt-4o",
      "gpt-4o-mini",
      "claude-3-5-sonnet-20241022",
      "claude-3-opus-20240229"
    ]
  }
}
